layout(local_size_x = 64) in;
layout(points, max_vertices = 64, max_primitives = 64) out;

const vec3 vertices[3] = {vec3(-1,-1,0), vec3(0,1,0), vec3(1,-1,0)};
const vec3 colors[3] = {vec3(1.0,0.0,0.0), vec3(0.0,1.0,0.0), vec3(0.0,0.0,1.0)};

struct Point{
	vec3 position;
	vec3 color;
	vec3 normal;
};

layout(binding = 0) buffer readonly PointData{
	Point pointArray[];
} pointsData;

layout(binding = 1) uniform WCPMatrices{
    mat4 world;
    mat4 view;
    mat4 proj;
} transformation; 

layout(location = 0) out vec3 outWorldPos[];
layout(location = 1) out vec4 outColor[];
layout(location = 2) out vec3 outNormal[];


void main(){
	// Vertices position
	gl_MeshVerticesEXT[gl_LocalInvocationID.x].gl_Position =  transformation.proj * transformation.view * transformation.world * vec4(pointsData.pointArray[gl_GlobalInvocationID.x].position, 1.0); 

	gl_MeshVerticesEXT[gl_LocalInvocationID.x].gl_PointSize = 4;

	outWorldPos[gl_LocalInvocationID.x] = (transformation.world * vec4(pointsData.pointArray[gl_GlobalInvocationID.x].position, 1.0)).xyz;

	outNormal[gl_LocalInvocationID.x] = (transformation.world * vec4(pointsData.pointArray[gl_GlobalInvocationID.x].normal, 0.0)).xyz;

	// Vertices color
	outColor[gl_LocalInvocationID.x] = vec4(pointsData.pointArray[gl_GlobalInvocationID.x].color, 1.0);

	// Points indices
	gl_PrimitivePointIndicesEXT[gl_LocalInvocationID.x] = gl_LocalInvocationID.x;

	// Number of points  
	SetMeshOutputsEXT(64, 64);
}