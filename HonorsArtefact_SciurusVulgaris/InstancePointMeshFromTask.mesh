#version 460

#extension GL_EXT_mesh_shader : require

layout(local_size_x = 128) in;
layout(points, max_vertices = 128, max_primitives = 128) out;

struct Point{
	vec3 position;
	vec3 color;
	vec3 normal;
};

layout(binding = 0) buffer readonly PointData{
	Point pointArray[];
} pointsData;

struct WCPMatrices{
    mat4 world;
    mat4 view;
    mat4 proj;
};

layout(binding = 1) readonly buffer UniformBufferObject {
    WCPMatrices matrices[4000];
    WCPMatrices lastMatrices[4000];
} transformation;

layout(binding = 2) uniform InstancingInfo {
    uint instanceCount;
    uint instanceStride;
} instanceInfo; 

layout(binding = 5) uniform TAAInfo {
	vec2 currentJitter;
    vec2 inverseScreenSize;
	bool enabled;
    bool logarithmicColorSpace;
} taaInfo; 

layout(location = 0) out vec3 outWorldPos[];
layout(location = 1) out vec4 outColor[];
layout(location = 2) out vec3 outNormal[];
layout(location = 3) out vec2 outVelocity[];

struct MyPayloadStruct {
    uint instanceIndex;
	uint debugLevel;
};
taskPayloadSharedEXT MyPayloadStruct payload;

const vec3[] debugColors = {vec3(1.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0), vec3(0.0, 0.0, 1.0), vec3(1.0, 1.0, 0.0), vec3(0.0, 1.0, 1.0), vec3(1.0, 0.0, 1.0), vec3(1.0, 1.0, 1.0), vec3(1.0, 1.0, 1.0)};

// (Lee, 2021)
vec2 CalcVelocity(vec4 newPos, vec4 oldPos)
{
    oldPos /= oldPos.w;
    oldPos.xy = (oldPos.xy + vec2(1,1))/2.0f;
    //oldPos.y = 1 - oldPos.y;
    
    newPos /= newPos.w;
    newPos.xy = (newPos.xy + vec2(1,1))/2.0f;
    //newPos.y = 1 - newPos.y;
    
    return (newPos - oldPos).xy;
}

void main(){
	uint instanceID = payload.instanceIndex;
	uint pointDataIndex = gl_GlobalInvocationID.x;// % (instanceInfo.instanceStride * 64);

	

	// Vertices position
	vec4 screenSpacePosition =  transformation.matrices[instanceID].proj * transformation.matrices[instanceID].view * transformation.matrices[instanceID].world * vec4(pointsData.pointArray[pointDataIndex].position, 1.0); 
	vec4 lastScreenSpacePosition =  transformation.lastMatrices[instanceID].proj * transformation.lastMatrices[instanceID].view * transformation.lastMatrices[instanceID].world * vec4(pointsData.pointArray[pointDataIndex].position, 1.0); 
	outVelocity[gl_LocalInvocationID.x] = CalcVelocity(screenSpacePosition, lastScreenSpacePosition);
	// Apply TAA Jitter
	if(taaInfo.enabled) screenSpacePosition += vec4(taaInfo.currentJitter * screenSpacePosition.w * 1.2f, 0, 0);
	gl_MeshVerticesEXT[gl_LocalInvocationID.x].gl_Position = screenSpacePosition;

	gl_MeshVerticesEXT[gl_LocalInvocationID.x].gl_PointSize = 1;

	outWorldPos[gl_LocalInvocationID.x] = (transformation.matrices[instanceID].world * vec4(pointsData.pointArray[pointDataIndex].position, 1.0)).xyz;

	outNormal[gl_LocalInvocationID.x] = (transformation.matrices[instanceID].world * vec4(pointsData.pointArray[pointDataIndex].normal, 0.0)).xyz;

	// Vertices color
	outColor[gl_LocalInvocationID.x] = vec4(pointsData.pointArray[pointDataIndex].color, 1.0);
	//outColor[gl_LocalInvocationID.x] = vec4(debugColors[payload.debugLevel % 8], 1.0);
	// Points indices
	gl_PrimitivePointIndicesEXT[gl_LocalInvocationID.x] = gl_LocalInvocationID.x;
	
	// Number of points  
	SetMeshOutputsEXT(128, 128);
}