#version 460

#extension GL_EXT_mesh_shader : require

// Task shader part of the point tree rendering mesh shaders

layout(local_size_x = 1) in; // 1 Invocation per tree

layout(binding = 1) readonly buffer UniformBufferObject {
    mat4 worldMatrices[1024000];
} transformation;

layout(binding = 2) uniform InstancingInfo {
    uint instanceCount;
    uint instanceStride;
    uint modelCount;
	uint myModelNumber;
} instanceInfo; 

layout(binding = 3) uniform MeshletInfo {
    uint meshletCount;
} meshletInfo; 

layout(binding = 4) uniform LODDataBuffer {
    vec4 cameraPosition;
    int maxVertexLevels[16];
    int maxLevel;
    float continousStart, continousShallowness, continousDecay;
	int lodType;
} levelOfDetailData;

struct MyPayloadStruct {
    uint instanceIndex;
    uint debugLevel;
};
taskPayloadSharedEXT MyPayloadStruct payload;

void main(){
    // Calculate instance ID based on total number of models loaded.
    uint instanceID = gl_GlobalInvocationID.x * instanceInfo.modelCount + instanceInfo.myModelNumber;

    // Calculate LOD Level
    vec3 instancePosition = (transformation.worldMatrices[instanceID] * vec4(0, 0, 0, 1)).xyz;
    vec3 cameraPosition = levelOfDetailData.cameraPosition.xyz; // Assumed for now

    float distanceToInstance = length(instancePosition - cameraPosition);
    uint level = 0;
    uint meshletCountToDraw = 0;
    if(levelOfDetailData.lodType == 0){ // RANDOM_LEVELS
        level =  clamp(uint(floor(distanceToInstance / 10.0f)), 0, levelOfDetailData.maxLevel - 1);
        meshletCountToDraw = uint(ceil(levelOfDetailData.maxVertexLevels[level] / 128.0));
    }
    else if(levelOfDetailData.lodType == 1){ // CONTINUOUS
        level = uint(floor(distanceToInstance / levelOfDetailData.continousShallowness));
        meshletCountToDraw = uint(ceil((levelOfDetailData.continousStart * pow(levelOfDetailData.continousDecay, -distanceToInstance * (1.0f / levelOfDetailData.continousShallowness))) / 128.0f ));
    }
    payload.debugLevel = level;
    payload.instanceIndex = instanceID;

    // Invoke mesh shader
    EmitMeshTasksEXT(meshletCountToDraw, 1, 1);
}